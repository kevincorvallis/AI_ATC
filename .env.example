# The public demo needs no environment variables or API credentials.
# Protected backend deployment: export these variables in your shell or CI.
# backend/deploy.sh does not read or execute .env files. See backend/README.md.
AWS_REGION=us-east-1
AWS_PROFILE=default
EXPECTED_AWS_ACCOUNT_ID=123456789012
ARTIFACT_BUCKET=your-private-artifact-bucket
STACK_NAME=ai-atc-protected

# Existing Secrets Manager JSON secret with an OPENAI_API_KEY field.
# Put the actual key in Secrets Manager, never in frontend configuration.
OPENAI_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:your-secret-name

# Configure a real client sign-in flow before enabling live mode.
JWT_ISSUER=https://your-identity-provider.example.com
JWT_AUDIENCE=your-client-audience
REQUIRED_SCOPE=atc:practice
ALLOWED_ORIGINS=https://klee.page
